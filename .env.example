# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=margdarshak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=margdarshak
# Host port for Postgres (5433 avoids clashing with a locally installed Postgres on 5432).
POSTGRES_HOST_PORT=5433
# Used by the backend when run outside Docker. Inside docker compose this is built automatically.
DATABASE_URL=postgresql+psycopg://margdarshak:change-me@localhost:5433/margdarshak

# --- Auth -------------------------------------------------------------------
# Required, 32+ characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=1440

# Optional admin bootstrap (run by the seed step on container start).
# If the account exists it is promoted; if not and ADMIN_PASSWORD is set, it is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- External APIs (all optional) -------------------------------------------
# Without them the app uses clearly labelled fallbacks: seasonal weather guidance,
# curated places, estimated distances and OpenStreetMap.
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
# Sent to browsers for the Maps JavaScript API, so use a separate key restricted by HTTP referrer.
GOOGLE_MAPS_BROWSER_KEY=

# --- Backend tuning ---------------------------------------------------------
# Comma-separated origins allowed by CORS (only needed when the frontend is served from another origin).
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
HTTP_TIMEOUT_SECONDS=6
# Optional JSON overriding recommendation weights (they're re-normalised), e.g. {"budget": 0.3, "season": 0.15}
RECOMMENDATION_WEIGHTS=
