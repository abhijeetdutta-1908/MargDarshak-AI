# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=margdarshak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=margdarshak
# Used by the backend. Inside docker compose the host is "postgres"; for a local run use localhost.
DATABASE_URL=postgresql+psycopg://margdarshak:change-me@postgres:5432/margdarshak

# --- Auth (used from Phase 2) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- External APIs (optional; app falls back to clearly-labelled seeded data) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=

# --- Backend ---
# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
